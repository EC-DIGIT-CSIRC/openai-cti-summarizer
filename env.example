# The version of this service.
VERSION=0.6

# LLM provider configuration. Supported providers:
# openai, azure, openrouter, ollama, anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini

# Canonical app-level API key used by openai, openrouter, ollama cloud, or anthropic
# when provider-specific environment variables are not preferred.
LLM_API_KEY=

# Optional base URL for OpenAI-compatible providers or Ollama.
# Example for local Ollama: http://localhost:11434/v1
LLM_BASE_URL=

# Azure OpenAI explicit provider configuration. For Azure, LLM_MODEL is the
# deployment-compatible model name.
LLM_AZURE_ENDPOINT=
LLM_AZURE_API_KEY=
LLM_AZURE_API_VERSION=

# Structured output mode. Native is strictest, but some models/providers may
# require tool or prompted mode.
LLM_OUTPUT_MODE=native
LLM_ALLOW_OUTPUT_FALLBACK=false
LLM_OUTPUT_FALLBACK_MODE=tool

# Request behavior and prompt grounding.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1
LLM_PROMPT_GROUNDING_HINT_LIMIT=50

# Return validated JSON from the web endpoint instead of rendered markdown HTML.
OUTPUT_JSON=false

# System prompt. The app always asks the LLM for structured CTISummary output;
# markdown is rendered locally from the validated schema.
SYSTEM_PROMPT="You are a Cyber Threat Intelligence Analyst. Extract a concise, factual, structured summary of the report. Prefer canonical MITRE ATT&CK and Malpedia values when they match the report. Leave yara_rules empty unless the report contains enough concrete strings, conditions, and context to support useful candidate rules."

# DRY_RUN=1 means: don't send a request to an LLM provider.
DRY_RUN=0

# HTTP Basic auth simple protection.
BASIC_AUTH_USER=<foo>
BASIC_AUTH_PASSWORD=<bar>

# Provider-native variables are also supported by Pydantic AI when using model
# strings or native providers:
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=
