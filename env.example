# The version of this service.
VERSION=0.6

# The DNS fqdn of the server. This is used for the TLS certificate and for traefik routing.
SERVERNAME="cti-summariser-dev.csirc.eu"


# LLM provider configuration. Supported providers:
# openai, azure, openrouter, ollama, anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini

# Canonical app-level API key used by openai, openrouter, ollama cloud, or anthropic
# when provider-specific environment variables are not preferred.
LLM_API_KEY=

# Optional base URL for OpenAI-compatible providers or Ollama.
# Example for local Ollama: http://localhost:11434/v1
LLM_BASE_URL=

# Azure OpenAI explicit provider configuration. For Azure, LLM_MODEL is the
# deployment-compatible model name.
LLM_AZURE_ENDPOINT=
LLM_AZURE_API_KEY=
LLM_AZURE_API_VERSION=

# Structured output mode. Native is strictest, but some models/providers may
# require tool or prompted mode.
LLM_OUTPUT_MODE=native
LLM_ALLOW_OUTPUT_FALLBACK=false
LLM_OUTPUT_FALLBACK_MODE=tool

# Request behavior and prompt grounding.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_PROMPT_GROUNDING_HINT_LIMIT=100

# Return validated JSON from the web endpoint instead of rendered markdown HTML.
OUTPUT_JSON=false

# System prompt. The app always asks the LLM for structured CTISummary output;
# markdown is rendered locally from the validated schema.
# System Prompt: Tell GPT* its system-role. Example below
SYSTEM_PROMPT='You are a Cyber Threat Intelligence Analyst and need to summarise a report for upper management. 
The report shall be nicely formatted with sections: 
  * one Executive Summary section
  * key points and recommendations section, which should be concise and actionable.
  * TTPs: List all TTPs mentioned in the report, including techniques, tactics, procedures, and any relevant details.
  * Indicators of Compromise (IoCs): List all IoCs mentioned in the report, such as IP addresses, domains, URLs, file hashes, and any other relevant indicators.
  * Threat Actors: a list of all threat actors mentioned in the report. Based on Malpedia nomenclature, if possible. Don\'t include more details about the Threat Actors. Just their names.
  * Confidence score
  * Report metadata
  * Yara rules: if applicable, generate Yara rules based only on the IoCs and TTPs which you extracted from the report. Don\'t generate Yara rules based on any other information in the report. 

IMPORANT: Only extract information which is explicitly mentioned in the report. Don\'t make any assumptions or inferences. If something is not explicitly mentioned, don\'t include it in the summary.
Double check your summary and TTPs and IOCs and Threat Actors and Yara rules. Make sure they are correct and based on the information in the report. Don\'t include any information which is not explicitly mentioned in the report. If you are not sure about something, don\'t include it in the summary.
After that, check coverage: Did you extract all TTPs, IoCs, and Threat Actors mentioned in the report? If not, go back and extract the missing information.
'

# DRY_RUN=1 means: don't send a request to an LLM provider.
DRY_RUN=0

# HTTP Basic auth simple protection.
BASIC_AUTH_USER=<foo>
BASIC_AUTH_PASSWORD=<bar>

# Traefik TLS certificate resolver. Use "le" for Let's Encrypt. Set this to an
# empty string to use a certificate configured directly on Traefik instead, such
# as a local certificate signed by your own CA.
TRAEFIK_TLS_CERT_RESOLVER=le
# or for bring your own certificate:
# TRAEFIK_TLS_CERT_RESOLVER=myresolver

# Provider-native variables are also supported by Pydantic AI when using model
# strings or native providers:
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=
