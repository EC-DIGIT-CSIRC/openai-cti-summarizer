# The version of this service.
VERSION=0.6

# The DNS fqdn of the server. This is used for the TLS certificate and for traefik routing.
SERVERNAME="cti-summariser-dev.csirc.eu"


# LLM provider configuration. Supported providers:
# openai, azure, openrouter, ollama, anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.5

# Canonical app-level API key used by openai, openrouter, ollama cloud, or anthropic
# when provider-specific environment variables are not preferred.
LLM_API_KEY=

# Optional base URL for OpenAI-compatible providers or Ollama.
# Example for local Ollama: http://localhost:11434/v1
LLM_BASE_URL=

# Azure OpenAI explicit provider configuration. For Azure, LLM_MODEL is the
# deployment-compatible model name.
LLM_AZURE_ENDPOINT=
LLM_AZURE_API_KEY=
LLM_AZURE_API_VERSION=

# Structured output mode. Native is strictest, but some models/providers may
# require tool or prompted mode.
LLM_OUTPUT_MODE=native
LLM_ALLOW_OUTPUT_FALLBACK=false
LLM_OUTPUT_FALLBACK_MODE=tool

# Request behavior and prompt grounding.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_PROMPT_GROUNDING_HINT_LIMIT=100

# Return validated JSON from the web endpoint instead of rendered markdown HTML.
OUTPUT_JSON=false

# System prompt. The app always asks the LLM for structured CTISummary output;
# markdown is rendered locally from the validated schema.
# System Prompt: Tell GPT* its system-role. Example below
SYSTEM_PROMPT='You are a Cyber Threat Intelligence analyst. Extract a concise, schema-valid CTISummary from the report.

<extraction_rules>
- Use only facts explicitly stated in the report. Do not infer, enrich, or guess missing details.
- If a schema field is unsupported by report evidence, use an empty list, null, or an empty metadata object as appropriate.
- Normalize TTPs to MITRE ATT&CK tactic or technique IDs and names when the report supports the match.
- Normalize threat actors to Malpedia common names when the report supports the match. Return names only.
- Extract IoCs exactly as written, including IP addresses, domains, URLs, file hashes, filenames, paths, registry keys, email addresses, and malware or tool names.
- Generate YARA rules only when the report contains enough concrete strings, conditions, and context. Base YARA only on extracted IoCs and TTPs.
- Keep summaries concise, factual, and useful for upper management.
</extraction_rules>

<output_expectations>
- summary: one short executive paragraph. Preferably onely two or three sentences. Keep it short.
- ttps: all explicitly mentioned or directly supported TTPs.
- indicators: all explicitly mentioned IoCs.
- threat_actors: all explicitly named or clearly aliased actors.
- report_metadata: source, title, publication date, author, or vendor when present.
- yara_rules: empty unless strong rule evidence exists.
</output_expectations>
'

# DRY_RUN=1 means: don't send a request to an LLM provider.
DRY_RUN=0

# HTTP Basic auth simple protection.
BASIC_AUTH_USER=<foo>
BASIC_AUTH_PASSWORD=<bar>

# Traefik TLS certificate resolver. Use "le" for Let's Encrypt. Set this to an
# empty string to use a certificate configured directly on Traefik instead, such
# as a local certificate signed by your own CA.
TRAEFIK_TLS_CERT_RESOLVER=le
# or for bring your own certificate:
# TRAEFIK_TLS_CERT_RESOLVER=myresolver

# Provider-native variables are also supported by Pydantic AI when using model
# strings or native providers:
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=
